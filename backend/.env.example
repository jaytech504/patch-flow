# Google AI Studio (Gemma)
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_MODEL=gemma-4-26b-a4b-it

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chaos_agent

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (required — enables "Login with GitHub")
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub PAT — optional fallback (for demo/dev use without OAuth)
GITHUB_TOKEN=your_github_personal_access_token

# JWT (change this in production!)
JWT_SECRET=a-strong-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Sentry integration (Phase 4 — Incident Fixes)
# Create an Internal Integration at: https://sentry.io/settings/<org>/developer-settings/
# Required permissions: Issue & Event (Read), Release (Read), Project (Read), Organization (Read)
# Subscribe to webhooks: Issues (Created, Unresolved), Errors (Created)
SENTRY_WEBHOOK_SECRET=your_sentry_client_secret_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your-sentry-org-slug

# Incident pipeline thresholds
# Only trigger fix generation when these minimums are met
INCIDENT_MIN_EVENTS=3          # minimum error event count
INCIDENT_MIN_USERS=1           # minimum affected users
INCIDENT_ENVIRONMENTS=production  # comma-separated environments to monitor
