# Google AI Studio (Gemma)
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_MODEL=gemma-4-26b-a4b-it

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chaos_agent

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (required — enables "Login with GitHub")
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub PAT — optional fallback (for demo/dev use without OAuth)
GITHUB_TOKEN=your_github_personal_access_token

# JWT (change this in production!)
JWT_SECRET=a-strong-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Incident pipeline thresholds
# Controls when SDK errors trigger fix generation
INCIDENT_MIN_EVENTS=3        # occurrences of same error before pipeline runs
INCIDENT_MIN_USERS=1
INCIDENT_ENVIRONMENTS=production

# Lemon Squeezy Billing (Merchant of Record)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_PRO_ANNUAL_VARIANT_ID=
LEMON_SQUEEZY_TEAM_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_TEAM_ANNUAL_VARIANT_ID=

# Email Service (Resend or SMTP for incident alerts)
RESEND_API_KEY=
EMAIL_FROM="PatchFlow Alerts <alerts@patchflow.dev>"
